# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stayclub
MYSQL_USER=stayuser
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
# Set to 1 when deploying behind HTTPS; leave 0 for local HTTP development.
COOKIE_SECURE=0
# Optional path to your managed MySQL provider's TLS CA certificate:
# MYSQL_SSL_CA=/app/certs/ca.pem
